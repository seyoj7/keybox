{
  "name": "keybox",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "lint": "eslint",
    "build:windows": "next build && electron-builder --win"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.48.0",
    "next": "16.4.0",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sql.js": "^1.14.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.186.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sharp": "^0.35.5",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.keybox.passwordmanager",
    "productName": "Keybox",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist/app",
      "buildResources": "installer-resources"
    },
    "files": [
      "electron/**",
      "!node_modules/**",
      "!.next/**",
      "!backend/**",
      "!app/**",
      "!public/**",
      "!dist-backend/**",
      "!build/**",
      "!dist/**",
      "!database/**"
    ],
    "afterPack": "electron/afterPack.js",
    "asar": true,
    "extraResources": [
      {
        "from": "dist/next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/next/static",
        "to": "app/dist/next/static"
      },
      {
        "from": "public",
        "to": "app/public"
      },
      {
        "from": "node_modules/sql.js",
        "to": "app/node_modules/sql.js"
      },
      {
        "from": "node_modules/hash-wasm",
        "to": "app/node_modules/hash-wasm"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "electron/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Keybox",
      "artifactName": "Keybox Setup ${version}.${ext}"
    }
  }
}
